PORT=3001
HOST=0.0.0.0
# Optional comma-separated IPs/CIDRs of trusted reverse proxies. Leave empty when directly exposed.
TRUSTED_PROXIES=
CLIENT_URL=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jwdb?schema=public
# Use a persistent, private directory for candidate CV and profile image uploads.
PRIVATE_UPLOAD_DIR=./private-uploads
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-account@gmail.com
SMTP_PASS=your-16-character-google-app-password
EMAIL_FROM=Jinowork <your-account@gmail.com>
NODE_ENV=development
