// Prisma schema for Jinowork
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ──────────────────────────────────────────

enum UserRole {
  CANDIDATE
  COMPANY
  ADMIN
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum OAuthProvider {
  GOOGLE
}

enum LanguageLevel {
  BASIC
  INTERMEDIATE
  ADVANCED
  NATIVE
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum RemoteScope {
  NICARAGUA_ONLY
  INTERNATIONAL
}

enum ContractType {
  PERMANENT
  TEMPORARY
  CONTRACT
  INTERNSHIP
}

enum Workday {
  FULL_TIME
  PART_TIME
}

enum ScheduleType {
  FIXED
  FLEXIBLE
  SHIFT_BASED
}

enum Currency {
  NIO
  USD
}

enum SalaryPeriod {
  HOURLY
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  REMOVED
}

enum ApplicationStatus {
  RECEIVED
  IN_REVIEW
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

enum ReportReason {
  FRAUD
  FAKE_JOB
  IMPERSONATION
  HARASSMENT
  INAPPROPRIATE_CONTENT
  OTHER
}

enum ReportStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  USER
  JOB
}

enum ModerationActionType {
  WARNING
  TEMPORARY_SUSPENSION
  PERMANENT_BAN
  REACTIVATE_ACCOUNT
  REMOVE_JOB
  RESTORE_JOB
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  RECRUITER
  VIEWER
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  ADMIN_INVITATION
}

enum NotificationType {
  APPLICATION_RECEIVED
  APPLICATION_STATUS_CHANGED
  JOB_EXPIRING
  REPORT_RESOLVED
  COMPANY_VERIFIED
  COMPANY_REJECTED
}

enum AuditActionType {
  ADMIN_INVITATION_CREATED
  ADMIN_INVITATION_ACCEPTED
  USER_ROLE_CHANGED
  USER_EMAIL_CHANGED
  USER_STATUS_CHANGED
  COMPANY_VERIFIED
  COMPANY_REJECTED
  JOB_PUBLISHED
  JOB_REMOVED
  APPLICATION_STATUS_CHANGED
  REPORT_RESOLVED
  MODERATION_ACTION_APPLIED
  JOB_STATUS_CHANGED
}

// ─── USERS AND AUTHENTICATION ───────────────────────

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique
  passwordHash    String?
  role            UserRole
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?
  onboardingStep  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oauthAccounts      OAuthAccount[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  notifications      Notification[]

  candidateProfile CandidateProfile?
  companyProfile   CompanyProfile?

  companyMemberships CompanyMember[]
  adminInvitationsCreated AdminInvitation[] @relation("AdminInvitationCreator")

  reportsCreated  Report[] @relation("ReportReporter")
  reportsAgainst  Report[] @relation("ReportReportedUser")
  reportsAssigned Report[] @relation("ReportAssignedAdmin")

  moderationActions         ModerationAction[]         @relation("ModerationAdmin")
  moderationActionsReceived ModerationAction[]         @relation("ModerationTargetUser")
  statusChanges             ApplicationStatusHistory[] @relation("StatusChangedBy")
  companiesVerified         CompanyProfile[]           @relation("CompanyVerifiedBy")
  auditLogs                 AuditLog[]                 @relation("AuditActor")

  @@index([role, status])
  @@index([emailVerifiedAt])
}

model OAuthAccount {
  id                String        @id @default(uuid()) @db.Uuid
  provider          OAuthProvider
  providerAccountId String
  userId            String        @db.Uuid
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([userId, revokedAt, expiresAt])
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  type      TokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model AdminInvitation {
  id              String    @id @default(uuid()) @db.Uuid
  email           String
  tokenHash       String    @unique
  invitedByUserId String?   @db.Uuid
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())

  invitedBy User? @relation("AdminInvitationCreator", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([expiresAt])
  @@index([invitedByUserId, createdAt])
}

// ─── CANDIDATE PROFILES ─────────────────────────────

model CandidateProfile {
  id                 String  @id @default(uuid()) @db.Uuid
  userId             String  @unique @db.Uuid
  firstName          String
  lastName           String
  contactEmail       String?
  phone              String?
  photoUrl           String?
  departmentId       String? @db.Uuid
  municipalityId     String? @db.Uuid
  professionalAreaId String? @db.Uuid
  specializationId   String? @db.Uuid
  description        String?
  cvUrl              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  department       Department?       @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  municipality     Municipality?     @relation(fields: [municipalityId], references: [id], onDelete: SetNull)
  professionalArea ProfessionalArea? @relation(fields: [professionalAreaId], references: [id], onDelete: SetNull)
  specialization   Specialization?   @relation(fields: [specializationId], references: [id], onDelete: SetNull)

  experiences  Experience[]
  education    Education[]
  languages    CandidateLanguage[]
  applications Application[]
  savedJobs    SavedJob[]
  jobViews     JobView[]

  @@index([professionalAreaId, specializationId])
  @@index([departmentId, municipalityId])
}

model Experience {
  id                 String    @id @default(uuid()) @db.Uuid
  candidateProfileId String    @db.Uuid
  position           String
  company            String
  startDate          DateTime  @db.Date
  endDate            DateTime? @db.Date
  description        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId, startDate])
}

model Education {
  id                 String    @id @default(uuid()) @db.Uuid
  candidateProfileId String    @db.Uuid
  institution        String
  degree             String
  startDate          DateTime? @db.Date
  endDate            DateTime? @db.Date
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId])
}

model Language {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  candidates CandidateLanguage[]
}

model CandidateLanguage {
  candidateProfileId String        @db.Uuid
  languageId         String        @db.Uuid
  level              LanguageLevel

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  language         Language         @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@id([candidateProfileId, languageId])
  @@index([languageId])
}

// ─── COMPANIES ──────────────────────────────────────

model CompanyProfile {
  id               String  @id @default(uuid()) @db.Uuid
  ownerUserId      String  @unique @db.Uuid
  name             String
  description      String?
  website          String?
  economicSectorId String? @db.Uuid
  departmentId     String? @db.Uuid
  municipalityId   String? @db.Uuid
  address          String?
  contactEmail     String?
  phone            String?
  taxId            String?

  verificationStatus VerificationStatus @default(PENDING)
  verifiedAt         DateTime?
  verifiedByUserId   String?            @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  verifiedBy     User?           @relation("CompanyVerifiedBy", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  economicSector EconomicSector? @relation(fields: [economicSectorId], references: [id], onDelete: SetNull)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  municipality   Municipality?   @relation(fields: [municipalityId], references: [id], onDelete: SetNull)

  members    CompanyMember[]
  jobs       Job[]
  dailyStats CompanyDailyStats[]

  @@index([economicSectorId])
  @@index([departmentId, municipalityId])
  @@index([verificationStatus])
}

model CompanyMember {
  id               String            @id @default(uuid()) @db.Uuid
  companyProfileId String            @db.Uuid
  userId           String            @db.Uuid
  role             CompanyMemberRole @default(RECRUITER)
  invitedAt        DateTime          @default(now())
  acceptedAt       DateTime?

  company CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyProfileId, userId])
  @@index([userId])
  @@index([companyProfileId, role])
}

// ─── JOB CATALOGS ───────────────────────────────────

model ProfessionalArea {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  isActive Boolean @default(true)

  specializations Specialization[]
  candidates      CandidateProfile[]
  jobs            Job[]
}

model Specialization {
  id                 String  @id @default(uuid()) @db.Uuid
  name               String
  professionalAreaId String  @db.Uuid
  isActive           Boolean @default(true)

  professionalArea ProfessionalArea   @relation(fields: [professionalAreaId], references: [id], onDelete: Cascade)
  candidates       CandidateProfile[]
  jobs             Job[]

  @@unique([professionalAreaId, name])
  @@index([professionalAreaId])
}

model EconomicSector {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique
  isActive Boolean @default(true)

  companies CompanyProfile[]
}

model Department {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  municipalities Municipality[]
  candidates     CandidateProfile[]
  companies      CompanyProfile[]
  jobs           Job[]
}

model Municipality {
  id           String @id @default(uuid()) @db.Uuid
  name         String
  departmentId String @db.Uuid

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  candidates CandidateProfile[]
  companies  CompanyProfile[]
  jobs       Job[]

  @@unique([departmentId, name])
  @@index([departmentId])
}

// ─── JOBS ───────────────────────────────────────────

model Job {
  id                 String  @id @default(uuid()) @db.Uuid
  companyProfileId   String  @db.Uuid
  createdByUserId    String? @db.Uuid
  title              String
  description        String
  requirements       String
  professionalAreaId String  @db.Uuid
  specializationId   String? @db.Uuid

  departmentId   String? @db.Uuid
  municipalityId String? @db.Uuid

  workMode     WorkMode
  remoteScope  RemoteScope?
  contractType ContractType
  workday      Workday

  scheduleType        ScheduleType
  scheduleDescription String?

  salaryMin        Decimal?      @db.Decimal(12, 2)
  salaryMax        Decimal?      @db.Decimal(12, 2)
  salaryCurrency   Currency?     @default(NIO)
  salaryPeriod     SalaryPeriod? @default(MONTHLY)
  salaryNegotiable Boolean       @default(false)

  experienceYearsMin Int?
  isUrgent           Boolean @default(false)
  vacancies          Int     @default(1)

  status      JobStatus @default(DRAFT)
  publishedAt DateTime?
  expiresAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          CompanyProfile   @relation(fields: [companyProfileId], references: [id], onDelete: Restrict)
  professionalArea ProfessionalArea @relation(fields: [professionalAreaId], references: [id], onDelete: Restrict)
  specialization   Specialization?  @relation(fields: [specializationId], references: [id], onDelete: SetNull)
  department       Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  municipality     Municipality?    @relation(fields: [municipalityId], references: [id], onDelete: SetNull)

  applications      Application[]
  reports           Report[]
  moderationActions ModerationAction[]
  views             JobView[]
  savedBy           SavedJob[]
  dailyStats        JobDailyStats[]

  @@index([status, publishedAt])
  @@index([status, expiresAt])
  @@index([professionalAreaId, specializationId])
  @@index([departmentId, municipalityId])
  @@index([workMode, contractType, workday])
  @@index([companyProfileId, status])
  @@index([companyProfileId, publishedAt])
}

model JobView {
  id                 String   @id @default(uuid()) @db.Uuid
  jobId              String   @db.Uuid
  candidateProfileId String?  @db.Uuid
  ipHash             String?
  userAgent          String?
  viewedAt           DateTime @default(now())

  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateProfile CandidateProfile? @relation(fields: [candidateProfileId], references: [id], onDelete: SetNull)

  @@index([jobId, viewedAt])
  @@index([candidateProfileId])
  @@index([viewedAt])
}

model SavedJob {
  candidateProfileId String   @db.Uuid
  jobId              String   @db.Uuid
  createdAt          DateTime @default(now())

  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  job              Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@id([candidateProfileId, jobId])
  @@index([jobId])
  @@index([candidateProfileId, createdAt])
}

// ─── APPLICATIONS ───────────────────────────────────

model Application {
  id                 String            @id @default(uuid()) @db.Uuid
  jobId              String            @db.Uuid
  candidateProfileId String            @db.Uuid
  status             ApplicationStatus @default(RECEIVED)
  appliedAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  job              Job              @relation(fields: [jobId], references: [id], onDelete: Restrict)
  candidateProfile CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Restrict)

  statusHistory ApplicationStatusHistory[]

  @@unique([jobId, candidateProfileId])
  @@index([candidateProfileId, status])
  @@index([jobId, status, appliedAt])
  @@index([appliedAt])
}

model ApplicationStatusHistory {
  id              String             @id @default(uuid()) @db.Uuid
  applicationId   String             @db.Uuid
  previousStatus  ApplicationStatus?
  newStatus       ApplicationStatus
  changedByUserId String?            @db.Uuid
  comment         String?
  createdAt       DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation("StatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

// ─── NOTIFICATIONS ──────────────────────────────────

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

// ─── REPORTS AND MODERATION ─────────────────────────

model Report {
  id              String           @id @default(uuid()) @db.Uuid
  reporterUserId  String           @db.Uuid
  targetType      ReportTargetType
  targetUserId    String?          @db.Uuid
  targetJobId     String?          @db.Uuid
  assignedAdminId String?          @db.Uuid
  assignedAt      DateTime?

  reason      ReportReason
  description String
  status      ReportStatus @default(PENDING)
  resolution  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  resolvedAt  DateTime?

  reporter      User  @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  targetUser    User? @relation("ReportReportedUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  targetJob     Job?  @relation(fields: [targetJobId], references: [id], onDelete: Restrict)
  assignedAdmin User? @relation("ReportAssignedAdmin", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  evidence ReportEvidence[]
  actions  ModerationAction[]

  @@index([status, createdAt])
  @@index([reporterUserId])
  @@index([targetUserId])
  @@index([targetJobId, status])
  @@index([assignedAdminId, status])
  @@index([targetType, status])
}

model ReportEvidence {
  id           String   @id @default(uuid()) @db.Uuid
  reportId     String   @db.Uuid
  fileUrl      String
  originalName String
  mimeType     String
  sizeBytes    BigInt
  createdAt    DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model ModerationAction {
  id           String  @id @default(uuid()) @db.Uuid
  adminUserId  String  @db.Uuid
  targetUserId String? @db.Uuid
  targetJobId  String? @db.Uuid
  reportId     String? @db.Uuid

  actionType ModerationActionType
  reason     String
  expiresAt  DateTime?
  createdAt  DateTime             @default(now())

  admin      User    @relation("ModerationAdmin", fields: [adminUserId], references: [id], onDelete: Restrict)
  targetUser User?   @relation("ModerationTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  targetJob  Job?    @relation(fields: [targetJobId], references: [id], onDelete: Restrict)
  report     Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([targetUserId, createdAt])
  @@index([targetJobId, createdAt])
  @@index([reportId])
  @@index([actionType, createdAt])
}

// ─── AUDIT LOG ──────────────────────────────────────

model AuditLog {
  id          String          @id @default(uuid()) @db.Uuid
  actorUserId String?         @db.Uuid
  actionType  AuditActionType
  entityType  String
  entityId    String
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime        @default(now())

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([actionType, createdAt])
}

// ─── COMPANY STATS (DASHBOARD) ──────────────────────

/// Snapshot diario de métricas por empresa.
/// Se recalcula con un cron job (ej. cada noche).
model CompanyDailyStats {
  id               String   @id @default(uuid()) @db.Uuid
  companyProfileId String   @db.Uuid
  date             DateTime @db.Date

  jobsPublished     Int @default(0)
  jobsActive        Int @default(0)
  totalViews        Int @default(0)
  uniqueViews       Int @default(0)
  totalApplications Int @default(0)
  totalSaved        Int @default(0)

  received    Int @default(0)
  inReview    Int @default(0)
  shortlisted Int @default(0)
  interview   Int @default(0)
  selected    Int @default(0)
  rejected    Int @default(0)
  withdrawn   Int @default(0)

  createdAt DateTime @default(now())

  company CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)

  @@unique([companyProfileId, date])
  @@index([companyProfileId, date])
  @@index([date])
}

/// Snapshot diario de métricas por vacante.
model JobDailyStats {
  id    String   @id @default(uuid()) @db.Uuid
  jobId String   @db.Uuid
  date  DateTime @db.Date

  views        Int @default(0)
  uniqueViews  Int @default(0)
  applications Int @default(0)
  savedCount   Int @default(0)

  received    Int @default(0)
  inReview    Int @default(0)
  shortlisted Int @default(0)
  interview   Int @default(0)
  selected    Int @default(0)
  rejected    Int @default(0)

  createdAt DateTime @default(now())

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, date])
  @@index([jobId, date])
  @@index([date])
}
